/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
:disabled{
    color: rgb(97, 91, 82);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QMainWindow{
    background-color: rgb(56, 58, 59);
}

QMainWindow::separator {
    border: 0px solid red;
}

QMainWindow::separator:hover {
    background-color: rgb(240, 127, 70);
}

QMainWindow > QScrollArea {
    background-color: rgb(22, 20, 18);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

QPushButton:!flat {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
    border: 1px solid black;
    color: white;
    opacity: 0.5;
    padding: 1ex 2ex;
}


QPushButton:default {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(29, 26, 24), stop:1 rgb(18, 17, 15));
    color:rgb(0,0,0);
    opacity: 0.5;
    padding: 1ex 2ex;
}

QPushButton:default:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(150, 142, 132), stop:1 rgb(97, 91, 82));
    color:rgb(0,0,0);
    opacity: 0.5;
}

QPushButton:hover:!flat {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(136, 128, 118), stop:1 rgb(76, 70, 63));
    color: white;
    opacity: 0.5;
}

QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(76, 70, 63), stop:1 rgb(45, 41, 37));
}

QPushButton:flat {
    border: none;
    background-color: transparent;
    padding: none;
    margin: none;
}

QPushButton:flat:!hover
{
    color:rgb(213, 206, 197);
}

QPushButton:flat:hover {
    color:rgb(236, 230, 222);
}

QDialogButtonBox > QPushButton, QDialog > QPushButton, QWizard > QWidget > QPushButton {
    min-width: 5em;
    min-height: 1.4em;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QDockWidget
{
    background-color: rgb(45, 41, 37);
    border-top: 1px solid blue;
    color : white;
}

QDockWidget::title
{
    background-color: rgb(45, 41, 37);
    border: 0px solid black;
    padding: 0.4em;
}

QDockWidget .QWidget
{
    background-color: rgb(21, 19, 17);
    color: rgb(204, 197, 187);
    border: 0px solid red;
}

QDockWidget QScrollArea
{
    border: 0px solid rgb(45, 41, 37);
}

#grabHandle
{
    background: none;
    min-width: 4;
    min-height: 16;
    max-width: 4;
    max-height: 16;
    image: url(:/particleQT/icons/grab_handle.png);
}

.DockWidget > #grabHandle
{
    margin-left: 1px;
    margin-right: 3px;
}

#Title > #grabHandle, #DockWidget::title > #grabHandle
{
    background: none;
    color: none;
    image: none;
}

QDockWidget > QScrollArea
{
    border: 0px solid rgb(52, 47, 42);
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QHeaderView::section{
color: rgb(218, 211, 203);
}

QHeaderView::section{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
    padding: 1ex;
}

QHeaderView::section:first{
    border-top: 0px solid black;
    border-right: 0px solid black;
    border-bottom: 1px solid black;
    border-left: 0px solid black;
}

QHeaderView::section:middle{
    border-top: 0px solid black;
    border-right: 0px solid black;
    border-bottom: 1px solid black;
    border-left: 1px solid black;
}

QHeaderView::section:last{
    border-top: 0px solid black;
    border-right: 0px solid black;
    border-bottom: 1px solid black;
    border-left: 1px solid black;
}

QHeaderView::section:hover{
background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(136, 128, 118), stop:1 rgb(76, 70, 63));
}

QHeaderView::section:pressed{
background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(136, 128, 118), stop:1 rgb(76, 70, 63));
}

/* style the sort indicator */
QHeaderView::down-arrow {
image: url(UI:arrow_down_V2.png);

width: 10px;
height: 10px;

padding-right: 1ex;
}

QHeaderView::up-arrow {
image: url(UI:arrow_up_V2.png);

width: 10px;
height: 10px;

padding-right: 1ex;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QScrollBar{
    background-color:  rgb(34, 34, 36);
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

QScrollBar::horizontal{
    border:0px solid rgb(45, 41, 37);
    border-left: 0px solid red;
    border-right: 0px solid red;

    margin: 0px 16px 0px 16px;
}

QScrollBar::vertical {
    border: 0px solid rgb(45, 41, 37);
    border-top: 0px solid red;
    border-bottom: 0px solid red;

    margin: 16px 0px 16px 0px;
}

QScrollBar::handle{
    background-color: rgb(63, 57, 51);
    border: 1px solid rgb(32, 28, 26);
}

QScrollBar::handle:horizontal{
    min-width: 20px;
}

QScrollBar::handle:vertical{
    min-height: 20px;
}

QScrollBar::handle:hover {
    background-color: rgb(97, 91, 82);
}

QScrollBar::handle:pressed {
    background-color: rgb(175, 167, 157);
}

QScrollBar::add-line:horizontal {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgb(29, 26, 24), stop:1 rgb(45, 41, 37));
    border: 1px solid rgb(45, 41, 37);
    border-left:0px;

    width: 15px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal{
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
    border: 1px solid rgb(45, 41, 37);
    border-right:0px;

    width: 15px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover{
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgb(52, 47, 42), stop:1 rgb(136, 128, 118));
}

QScrollBar::sub-line:horizontal:hover{
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgb(136, 128, 118), stop:1 rgb(52, 47, 42));
}

QScrollBar::add-line:horizontal:pressed{
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgb(97, 91, 82), stop:1 rgb(175, 167, 157));
}

QScrollBar::sub-line:horizontal:pressed{
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgb(175, 167, 157), stop:1 rgb(97, 91, 82));
}

QScrollBar::add-line:vertical {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(29, 26, 24), stop:1 rgb(45, 41, 37));
    border: 1px solid rgb(45, 41, 37);
    border-top:0px;

    height: 15px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
    border: 1px solid rgb(45, 41, 37);
    border-bottom:0px;

    height: 15px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(52, 47, 42), stop:1 rgb(136, 128, 118));
}

QScrollBar::sub-line:vertical:hover{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(136, 128, 118), stop:1 rgb(52, 47, 42));
}

QScrollBar::add-line:vertical:pressed{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(97, 91, 82), stop:1 rgb(175, 167, 157));
}

QScrollBar::sub-line:vertical:pressed{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(97, 91, 82));
}

QScrollBar::left-arrow:horizontal{
    background-image: url(UI:arrow_left_V2.png);
    background-position: center;
}

QScrollBar::right-arrow{
    background-image: url(UI:arrow_right_V2.png);
    background-position: center;
}

QScrollBar::up-arrow:vertical{
    background-image: url(UI:arrow_up_V2.png);
    background-position: center;
}

QScrollBar::down-arrow:vertical{
    background-image: url(UI:arrow_down_V2.png);
    background-position: center;
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QSplitter{
    background-color: transparent;
    border: 0px solid red;
}

QSplitter::handle{
    background-color: rgb(21, 19, 17);
    border: 0px solid green;
}

/* ---------------------------------------------------------------------------
    Scroll Views
    --------------------------------------------------------------------------*/
    
QScrollArea > QWidget {
    background-color: rgb(76, 70, 63);
}

QScrollArea > QWidget > QWidget {   
    background-color: rgb(117, 110, 101);
    color: rgb(218, 211, 203);
}

/*----------------------------------------------------------------------------*/
/* All Tree Views */
/*----------------------------------------------------------------------------*/

QTreeView{
    background-color: rgb(52, 47, 42);
    alternate-background-color:  rgb(45, 41, 37);
    border: 0px solid black;
    color: rgb(218, 211, 203);
}

QTreeView:enabled{
    background-color: rgb(52, 47, 42);
    alternate-background-color:  rgb(45, 41, 37);
}

QTreeView:!enabled{
    background-color: rgb(22, 20, 18);
    alternate-background-color:  rgb(20, 18, 16);
}

QTreeView:active{
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
}

QTreeView:!active{
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(34, 31, 28));
}

QTreeView::item:enabled{
    color: rgb(218, 211, 203);
}

QTreeView::item:!enabled{
    color: rgb(91, 84, 77);
}

QTreeView::item QWidget {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
    color: rgb(218, 211, 203);
}

QTreeView::item:selected:!active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(34, 31, 28), stop:1 rgb(23, 21, 19));
}

QTreeView::item:selected:active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
}

QTreeView::item:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(63, 57, 51), stop:1 rgb(76, 70, 63));
}

QTreeView::branch:closed:has-children:!has-siblings, QTreeView::branch:closed:has-children:has-siblings
{
    border-image: none;
    image: url(UI:treeview_arrow_right.png);
}

QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings
{
    border-image: none;
    image: url(UI:treeview_arrow_down.png);
}

QTreeView::indicator
{
    border: 0px solid red;
    width: 14px;
    height: 16px;
}

QTreeView::indicator:unchecked {
    image: url(UI:checkbox_unchecked.png);
}

QTreeView::indicator:unchecked:disabled{
    image: url(UI:checkbox_unchecked_disabled.png);
}

QTreeView::indicator:checked{
    image: url(UI:checkbox_checked.png);
}

QTreeView::indicator:checked:disabled{
    image: url(UI:checkbox_checked_disabled.png);
}

QListView{
    background-color: rgb(52, 47, 42);
    alternate-background-color:  rgb(45, 41, 37);
    border: 0px solid black;
    color: rgb(218, 211, 203);
}

QListView:enabled{
    background-color: rgb(52, 47, 42);
    alternate-background-color:  rgb(45, 41, 37);
}

QListView:!enabled{
    background-color: rgb(22, 20, 18);
    alternate-background-color:  rgb(20, 18, 16);
}

QListView:active{
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
}

QListView:!active{
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(34, 31, 28));
}

QListView::item:enabled{
    color: rgb(218, 211, 203);
}

QListView::item:!enabled{
    color: rgb(91, 84, 77);
}

QListView::item QWidget {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
    color: rgb(218, 211, 203);
}

QListView::item:selected:!active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(34, 31, 28), stop:1 rgb(23, 21, 19));
}

QListView::item:selected:active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
}

QListView::item:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(63, 57, 51), stop:1 rgb(76, 70, 63));
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


QTableView{
    background-color: rgb(52, 47, 42);
    alternate-background-color:  rgb(45, 41, 37);
    border: 0px solid black;
    color: rgb(218, 211, 203);
}

QTableView:enabled{
    background-color: rgb(52, 47, 42);
    alternate-background-color:  rgb(45, 41, 37);
}

QTableView:!enabled{
    background-color: rgb(22, 20, 18);
    alternate-background-color:  rgb(20, 18, 16);
}

QTableView:active{
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
}

QTableView:!active{
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(34, 31, 28));
}

QTableView::item:enabled{
    color: rgb(218, 211, 203);
}

QTableView::item:!enabled{
    color: rgb(91, 84, 77);
}

QTableView::item QWidget {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
    color: rgb(218, 211, 203);
}

QTableView::item:selected:!active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(34, 31, 28), stop:1 rgb(23, 21, 19));
}

QTableView::item:selected:active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(39, 36, 32), stop:1 rgb(29, 26, 24));
}

QTableView::item:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(63, 57, 51), stop:1 rgb(76, 70, 63));
}





/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QMenuBar{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(76, 70, 63), stop:1 rgb(52, 47, 42));
}

QMenuBar::item{
    background-color: transparent;
    color: rgb(218, 211, 203);
}

QMenuBar::item:selected{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(97, 91, 82));
    color: rgb(218, 211, 203);
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QMenu{
background-color: rgb(29, 26, 24);
color: rgb(218, 211, 203);
border: 0px solid red;
padding: 5px;
}

QMenu::item{
background-color: transparent;
border: 1px solid transparent;
padding: 2px 25px 2px 20px;
}

QMenu::item:selected{
background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(136, 128, 118), stop:1 rgb(52, 47, 42));
border: 1px solid transparent;
color:rgb(218, 211, 203);
}

QMenu::separator{
height: 1px;
background-color: rgb(218, 211, 203);
margin: 5px 25px 5px 20px;
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QDialog{
    background-color:  rgb(48, 44, 39);
    border: 0px solid black;
}

QDialog WScrollArea{
    background-color: rgb(21, 19, 17);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QTabWidget::pane { /* The tab widget frame */    
    border: 0px solid black;
    margin-top:-1px;
}

QTabWidget::tab-bar {
    width: 9999px;
}

/*----------------------------------------------------------------------------*/
/* TOP TAB BAR */
/*----------------------------------------------------------------------------*/
QTabBar{
    background-color: rgb(39, 36, 32);
    border:0px solid red;
    color: rgb(39, 36, 32);
}

QTabBar::tab{
    background-color: rgb(21, 19, 17);
    min-width:3em;
    padding: 0.5ex 0.5em;
    color: rgb(189, 181, 171);
}

QTabBar::tab:selected{
    background-color: rgb(76, 70, 63);
    border-width: 1px;
    border-style: solid;
    color: rgb(223, 217, 208);
}

QTabBar::tab:top:selected{
    border-bottom-color: rgb(93, 87, 78);
    border-top-color: rgb(175, 167, 157);
    border-left-color: rgb(175, 167, 157);
    border-right-color: rgb(175, 167, 157);
}

QTabBar::tab:bottom:selected{
    border-top-color: rgb(93, 87, 78);
    border-bottom-color: rgb(175, 167, 157);
    border-left-color: rgb(175, 167, 157);
    border-right-color: rgb(175, 167, 157);
}

QTabBar::tab:!selected{
    border: 1px solid rgb(39, 36, 32);
    margin-top: 2px;
}

QTabBar::tab:first:selected{
    margin-left: 0px;
    margin-right: -2px;
}

QTabBar::tab:middle:selected{
    margin-left: 0px;
    margin-right: -2px;
}

QTabBar::tab:last:selected{
    margin-left: 0px;
    margin-right: 0px;
}

QTabBar::tab:last:!selected{
    border-left:0px solid red;
    border-right:0px solid black;
}

QTabBar::tab:!selected:hover{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

QProgressBar {
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
    border: 1px solid black;
    color:black;
    border-radius: 6px;
}

QProgressBar::chunk{
    background-color:qlineargradient(x1:0, y0:0, x2:0, y2:1, stop:0 rgb(255, 93, 0), stop:1 rgb(180, 45, 0));
    border: 1px solid rgba(236, 230, 222,128);
    border-radius: 3px;
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QToolBar{
    border: 0px;
    spacing: 0px;
}

QToolBar:horizontal{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(0, 0, 0), stop:0.035 rgb(67, 69, 70), stop:0.95 rgb(21, 19, 17), stop:0.98 rgb(0, 0, 0));
}

QToolBar:vertical{
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0.98 rgb(0, 0, 0), stop:0.95 rgb(67, 69, 70), stop:0.035 rgb(21, 19, 17), stop:0 rgb(0, 0, 0));
}

QToolBar:separator{
    background-color:qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(45, 41, 37));;
    border-right: 0px solid black;
    border-bottom: 0px solid black;

    width:1px;
    height:1px;
    margin:5px;
}

QToolButton {
    width: 24px;
    height: 24px;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QSlider::groove:horizontal {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(117, 110, 101));
    border: 0px solid rgb(29, 26, 24);
    height: 8px; /* the groove expands to the size of the slider by default. by giving it a height, it has a fixed size */
}

QSlider::handle:horizontal {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(117, 110, 101));
    border: 1px solid rgb(29, 26, 24);
    width: 8px;
    margin: -2px 0; /* handle is placed by default on the contents rect of the groove. Expand outside the groove */
    border-radius: 2px;
}

QSlider::handle:horizontal:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(218, 211, 203), stop:1 rgb(175, 167, 157));
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QStatusBar{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(45, 41, 37), stop:1 rgb(29, 26, 24));
    color: rgb(218, 211, 203);
    border: 0px solid red;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
DlgSettings QToolButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(29, 26, 24), stop:1 rgb(45, 41, 37));
    color:rgb(218, 211, 203);
}

DlgSettings QTabWidget::pane {
    background-color: rgb(29, 26, 24);
}

DlgSettings QTabBar[shape="0"]::tab:selected {
    background-color: rgb(29, 26, 24);
    color: white;
    border-top:3px solid rgb(249, 107, 36);
}

QToolButton {
    background-color: transparent;
    border: 0px solid red;
    color:rgb(218, 211, 203);
}

QToolButton::hover{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(34, 31, 28), stop:1 rgb(27, 24, 22));
}

QToolButton::checked{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(34, 31, 28), stop:1 rgb(27, 24, 22));
}

QToolButton::pressed{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(76, 70, 63), stop:1 rgb(45, 41, 37));
}

QToolButton[popupMode="1"]{
    padding-right: 10px;
}

QToolButton::menu-button{
    border: 0px solid red;
}

QToolButton::menu-button:hover{
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(136, 128, 118));
}

QToolButton::menu-button:pressed{

}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QLabel, QCheckBox, QRadioButton
{
    color: rgb(204, 197, 187);
}

QLabel:focus, QCheckBox:focus, QRadioButton:focus{
    color: rgb(233, 227, 219);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QSpinBox, QDoubleSpinBox {
    border: 1px solid black;
    padding:0px;

    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(136, 128, 118));
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(76, 70, 63), stop:1 rgb(29, 26, 24));
    selection-color: white;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid white;
    padding:0px;

    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(204, 197, 187), stop:1 rgb(162, 154, 144));
    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(117, 110, 101), stop:1 rgb(39, 36, 32));
    selection-color: white;
}


QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    border-width: 0px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    border-image: url(UI:spinbox_up.png);
    height:7px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    border-image: url(UI:spinbox_down.png);
    height:7px;
}

QSpinBox:disabled, QDoubleSpinBox:disabled
{
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(136, 128, 118), stop:1 rgb(76, 70, 63));
    color: rgb(31, 28, 25);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QCheckBox::indicator:unchecked{
    image: url(UI:checkbox_unchecked.png);
}

QCheckBox::indicator:unchecked:disabled{
    image: url(UI:checkbox_unchecked_disabled.png);
}

QCheckBox::indicator:checked{
    image: url(UI:checkbox_checked.png);
}

QCheckBox::indicator:checked:disabled{
    image: url(UI:checkbox_checked_disabled.png);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QRadioButton::indicator:unchecked{
    image: url(UI:radiobutton_unchecked.png);
}

QRadioButton::indicator:unchecked:disabled{
    image: url(UI:radiobutton_unchecked_disabled.png);
}

QRadioButton::indicator:checked{
    image: url(UI:radiobutton_checked.png);
}

QRadioButton::indicator:checked:disabled{
    image: url(UI:radiobutton_checked_disabled.png);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QLineEdit {
    border: 1px solid black;
    padding:0px;

    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(34, 31, 28), stop:1 rgb(27, 24, 22));
    color:white;

    selection-background-color: rgb(22, 20, 18);
    selection-color: white;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QLineEdit:focus {
    border: 1px solid white;
    padding:0px;

    background-color:  rgb(22, 20, 18);
    color:white;

    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(117, 110, 101), stop:1 rgb(39, 36, 32));
    selection-color: white;
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QComboBox
{
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(136, 128, 118));
    color:white;

    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(76, 70, 63), stop:1 rgb(29, 26, 24));
    selection-color: white;
    border: 1px black;
}

QComboBox:focus
{
    border: 1px solid white;
    padding:0px;

    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(204, 197, 187), stop:1 rgb(162, 154, 144));
    color:black;

    selection-background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(117, 110, 101), stop:1 rgb(39, 36, 32));
    selection-color: white;
}

QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border: 0px;
}

QComboBox::down-arrow
{
    image: url(UI:dropdown_arrow.png);
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/* fix group box */
QGroupBox{
    color: rgb(204, 197, 187);
    background-color: rgb(45, 41, 37);
    border: 1px solid black;

    margin-top: 1.1em; /* leave space at the top for the title */
    margin-bottom: 0.1em; /* leave space at the top for the title */

    font-weight: bold;
}

QGroupBox::title{
    border: 0px solid red;

    subcontrol-origin: margin;
    top: 0px;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QTextEdit{
    background-color: rgb(45, 41, 37);
    color: rgb(218, 211, 203);
    border: 3px solid rgb(45, 41, 37);

    selection-background-color:  rgb(29, 26, 24) ;
    selection-color: rgb(218, 211, 203);
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QToolTip{
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(136, 128, 118));
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QWizard{
}

QWizard > QWidget{
    background-color: rgb(21, 19, 17);
    color:rgb(218, 211, 203);
}

QWizard > QFrame{
    background-color: rgb(21, 19, 17);
    color:rgb(218, 211, 203);
}

QWizard  > QWidget > QLabel{
    background-color: rgb(21, 19, 17);
    color:rgb(218, 211, 203);
}

QWizard QListView{
    background-color: rgb(29, 26, 24);
    color:rgb(218, 211, 203);
}


QWizardPage > QFrame{
    background-color: transparent;
    border: 1px solid black;
}

SearchLineEdit{
    background-color:  transparent;
    border: 0px solid black;
    padding: 0px;
}

SearchLineEdit>QLineEdit{
    background-color: rgb(150, 142, 132);
}


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
QPlainTextEdit{
    border: 0px solid rgb(0, 0, 0);
    background-color: rgb(45, 41, 37);
    color: rgb(218, 211, 203);
    selection-background-color:  rgb(218, 211, 203) ;
    selection-color: rgb(45, 41, 37);
}

QPlainTextEdit:focus{
    background-color: rgb(45, 41, 37);
    selection-background-color:  rgb(218, 211, 203) ;
    selection-color: rgb(45, 41, 37);
}

QPlainTextEdit:!focus{
    background-color: rgb(34, 31, 28);
    color: rgb(204, 197, 187);
    selection-background-color:  rgb(204, 197, 187) ;
    selection-color: rgb(34, 31, 28);
}

QPlainTextEdit[readOnly="true"]:focus{
    background-color: rgb(34, 31, 28);
    color: rgb(204, 197, 187);
    selection-background-color:  rgb(204, 197, 187) ;
    selection-color: rgb(34, 31, 28);
}

QPlainTextEdit[readOnly="true"]:!focus{
    background-color: rgb(23, 21, 19);
    color: rgb(175, 167, 157);
    selection-background-color:  rgb(175, 167, 157) ;
    selection-color: rgb(23, 21, 19);
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

QPushButton#captureButton {
    background-color: "#F3811D";
    border: 1px solid #212223;
    color: #ece6de;
}

QPushButton#captureButton:disabled {
    background-color: rgba(90,44,4,50%);
    border: 1px solid #212223;
    color: rgba(236, 230, 222,50%);
}
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

AzToolsFramework--TargetSelectorButton#targetButton {
    color: white;
}

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

LUAEditor--LUAEditorBreakpointWidget:!enabled { 
    border: 0px solid rgb(0, 0, 0);
}

LUAEditor--LUAEditorBreakpointWidget:enabled { 
    border: 0px solid rgb(0, 0, 0);
}

LUAEditor--FoldingWidget:!enabled { 
    border: 0px solid rgb(0, 0, 0);
    background-color: rgb(34, 31, 28);
}

LUAEditor--FoldingWidget:enabled { 
    border: 0px solid rgb(0, 0, 0);
    background-color: rgb(45, 41, 37);
}

LUAEditor--LUAEditorSettingsDialog QFrame {
    background-color: rgb(45, 41, 37);
}

HexPropertySystem--PropertyAssetCtrl QLabel:!focus
{
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(175, 167, 157), stop:1 rgb(136, 128, 118));
    color: black;
    border: 1px solid black;
}

HexPropertySystem--PropertyAssetCtrl QLabel:focus
{
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(204, 197, 187), stop:1 rgb(162, 154, 144));
    color: black;
    border: 1px solid white;
}

HexPropertySystem--PropertyAssetCtrl QLabel[drophighlight="true"]
{
    background-color:  qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(180, 255, 180), stop:1 rgb(150, 255, 150));
