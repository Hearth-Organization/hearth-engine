/* Override transparent background colour for default QTabWidgets */
QTabWidget,
QTabBar
{
    background-color: #211E1B;
}

QTabBar::tab
{
    max-width: 200px;
}

AzQtComponents--TabWidget
{
    background-color: #0D0C0B;
}

AzQtComponents--TabWidget > QWidget
{
    background-color: #211E1B;
}

AzQtComponents--TabWidget QMenu
{
    background-color: #141210;
}

AzQtComponents--TabWidget:pane
{
    border: 0 none;
}

AzQtComponents--TabWidget.Empty:pane
{
    margin-top: 30px;
}

AzQtComponents--TabBar
{
    qproperty-drawBase: false; /* Stop the base being visible during tab position change animation */
    background-color: #0D0C0B;
    margin-bottom: 0;
    min-height: 28px;

    /* Disable the tab slide animation as the text is not animated */
    widget-animation-duration: 0;
}

AzQtComponents--TabBar:tab
{
    border: 1px solid #0D0C0B;
    background-color: #171513;
    padding: 6px 21px 6px 9px; /* top, right, bottom, left */
}

AzQtComponents--TabBar::close-button
{
    image: url(":/stylesheet/img/close_small.svg");
    margin-right: 4px;
}

AzQtComponents--TabBar::close-button:hover
{
    background-color: rgba(236, 230, 222, 0.2);
    border-radius: 2px;
}

AzQtComponents--TabBar::tab:text
{
    font-size: 12px;
    line-height: 24px;
}

AzQtComponents--TabBar::tab:selected
{
    border-bottom: 1px solid #211E1B;
}

AzQtComponents--TabBar::tab:selected,
AzQtComponents--TabBar::tab:hover
{
    background-color: #211E1B;
}

AzQtComponents--TabBar:focus
{
    outline: none;
    border: none;
}

/* Secondary Style */

AzQtComponents--TabWidget.Secondary
{
    background-color: #211E1B;
}

AzQtComponents--TabWidget.Secondary.Bordered
{
    border: 1px solid #0D0C0B;
}

AzQtComponents--TabWidget.Secondary:pane
{
    border: 0 none;
    border-top: 2px solid #161412;
    padding: 3px;
    padding-top: 0;
}

AzQtComponents--TabWidget.Secondary:tab-bar
{
    left: 1px;
    min-height: 30px;
}

AzQtComponents--TabBar.Secondary
{
    border: 0 none;
}

AzQtComponents--TabBar.Secondary.Bordered
{
    border-left: 1px solid #0D0C0B;
    border-top: 1px solid #0D0C0B;
}

AzQtComponents--TabBar.Secondary::tab
{
    background-color: #211E1B;
    border: 0 none;
    border-bottom: 3px solid #171513;
    padding: 7px 14px 5px 14px;
    color: #867E74;
}

AzQtComponents--TabBar.Secondary::tab:hover
{
    background: rgba(236, 230, 222,0.15);
    border-bottom: 3px solid #211E1B;
    color: #ECE6DE;
}

AzQtComponents--TabBar.Secondary.Bordered::tab
{
    border-top: 1px solid #0D0C0B;
    padding: 6px 14px 6px 14px;
}

AzQtComponents--TabBar.Secondary::tab:selected
{
    border-bottom: 3px solid #DF4E06;
    color: #ECE6DE;
}
