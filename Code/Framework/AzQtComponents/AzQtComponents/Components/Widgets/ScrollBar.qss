QScrollBar
{
    border: 2px solid rgba(0, 0, 0, 0%);
    background: transparent;
    margin: 0px;
}

QScrollBar:vertical
{
    width: 8px;
}

QScrollBar:horizontal
{
    height: 8px;
}

QScrollBar::handle
{
    border: 0px solid #000000;
    border-radius: 2px;
    background-color: rgba(236, 230, 222, 40%);
}

QAbstractScrollArea.DarkScrollBar QScrollBar::handle
{
    border: 0px solid #000000;
    border-radius: 2px;
    background-color: rgba(110, 103, 94, 64%);
}

QScrollBar::handle:vertical {
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
}

QScrollBar::add-line,
QScrollBar::sub-line
{
     border: none;
     background: none;
     color: none;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal
{
     width: 0px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical
{
     height: 0px;
}

QAbstractScrollArea > .QWidget
{
    background: none;
}

/* scrollbar hovered */

QScrollBar:hover
{
    border: 1px solid rgba(0, 0, 0, 0%);
    background-color: rgb(42, 38, 34);
    margin: 0px;
}

QAbstractScrollArea.DarkScrollBar QScrollBar:hover
{
    border: 1px solid rgba(0, 0, 0, 0%);
    background-color: rgb(218, 211, 203);
    margin: 0px;
}

QAbstractScrollArea > .QWidget:hover,
QAbstractScrollArea > .QWidget[ShowBackground=true]
{
    background-color: rgb(42, 38, 34);
}

QAbstractScrollArea.DarkScrollBar > .QWidget:hover,
QAbstractScrollArea.DarkScrollBar > .QWidget[ShowBackground=true]
{
    background-color: rgb(218, 211, 203);
}
